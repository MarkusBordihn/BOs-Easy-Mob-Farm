{
  "schemaVersion": 1,
  "id": "easy_mob_farm",
  "version": "${version}",
  "name": "Easy Mob Farm",
  "description": "The Easy Mob Farm offers a server-friendly solution for capturing various animals and mobs to\nharvest their valuable loot.",
  "authors": [
    "Markus Bordihn"
  ],
  "contact": {
    "homepage": "https://curseforge.com/minecraft/mc-mods/easy-mob-farm",
    "issues": "https://github.com/MarkusBordihn/BOs-Easy-Mob-Farm/issues"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.markusbordihn.easymobfarm.EasyMobFarm"
    ],
    "client": [
      "de.markusbordihn.easymobfarm.EasyMobFarmClient"
    ],
    "fabric-gametest": [
      "de.markusbordihn.easymobfarm.gametest.SmokeTest",
      "de.markusbordihn.easymobfarm.gametest.ModBlocksTest",
      "de.markusbordihn.easymobfarm.gametest.ModBlockItemsTest",
      "de.markusbordihn.easymobfarm.gametest.ModItemsTest",
      "de.markusbordihn.easymobfarm.gametest.MobFarmBlockItemsTest",
      "de.markusbordihn.easymobfarm.gametest.LootTablesTest",
      "de.markusbordihn.easymobfarm.gametest.LootManagerTest",
      "de.markusbordihn.easymobfarm.gametest.MobVariantDataTest",
      "de.markusbordihn.easymobfarm.gametest.MobCaptureCardDropTest",
      "de.markusbordihn.easymobfarm.gametest.MobFarmBlockEntityTest",
      "de.markusbordihn.easymobfarm.gametest.MobCatcherTest",
      "de.markusbordihn.easymobfarm.gametest.RedstoneSignalTest"
    ],
    "jei_mod_plugin": [
      "de.markusbordihn.easymobfarm.compat.jei.EasyMobFarmJeiPlugin"
    ]
  },
  "mixins": [
    "easymobfarm.mixins.json"
  ],
  "accessWidener": "easymobfarm.accesswidener",
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": "${java_version_range}"
  },
  "suggests": {
    "tooltipfix": "*"
  }
}
